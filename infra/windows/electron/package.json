{
  "name": "sigeda-desktop",
  "version": "0.1.0",
  "description": "Aplicacion de escritorio SIGEDA (Sistema de Gestion Documental del Acueducto), sobre la base de codigo de LICS v2.5.0 de Alejandro Arias Rojas",
  "main": "main.js",
  "author": "Equipo SIGEDA (IF6100, UCR Sede de Occidente) — basado en LICS v2.5.0 de Alejandro Arias Rojas",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "sync-version": "node scripts/sync-version.js",
    "predist": "npm run sync-version",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "cr.ucr.sigeda",
    "productName": "SIGEDA",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/windows",
        "to": "windows"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SIGEDA",
      "include": "build/installer.nsh"
    }
  }
}
