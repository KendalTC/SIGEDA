[Unit]
Description=SIGEDA — Sistema de Gestión Documental del Acueducto (base de código de LICS v2.5.0, Alejandro Arias Rojas)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/sigeda
ExecStart=/opt/sigeda/scripts/start.sh
ExecStop=/opt/sigeda/scripts/stop.sh
TimeoutStartSec=300
TimeoutStopSec=120
Restart=no

[Install]
WantedBy=multi-user.target
