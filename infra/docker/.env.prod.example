# -----------------------------------------------------------------------------
# Versión instalada
# -----------------------------------------------------------------------------

SIGEDA_VERSION=0.1.0-alpha


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

POSTGRES_DB=sigeda
POSTGRES_USER=sigeda
POSTGRES_PASSWORD=REEMPLAZAR_CON_CONTRASENA_ALEATORIA
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.production

# Obligatorio en producción.
# Debe ser una clave aleatoria fuerte, de al menos 50 caracteres.
# No usar este valor literal.
DJANGO_SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_AL_MENOS_50_CARACTERES

DJANGO_DEBUG=False

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

DJANGO_LOG_LEVEL=INFO
DJANGO_DB_CONN_MAX_AGE=60

# Producción local inicial: HTTP sobre localhost.
# Activar estas opciones solo si se configura HTTPS real.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0


# -----------------------------------------------------------------------------
# Almacén de documentos cifrados (RNF-10, ADR-02)
# -----------------------------------------------------------------------------

# Clave AES-256 (32 bytes) en base64. Generarla con:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# NUNCA reutilizar un valor de ejemplo ni subir la real a Git. En
# producción, además de esta variable (RNF-13): una copia física y
# otra digital de la clave, fuera del repositorio y fuera de esta
# laptop.
DOCUMENT_ENCRYPTION_KEY_B64=REEMPLAZAR_CON_CLAVE_AES256_EN_BASE64

DOCUMENT_STORAGE_ROOT=/app/almacen_cifrado


# -----------------------------------------------------------------------------
# Respaldo (RF-16/ADR-03) y exportación (RF-18/RN-10)
# -----------------------------------------------------------------------------

# Destinos del paquete de respaldo cifrado. En esta laptop de
# producción son rutas dentro de los volúmenes Docker declarados en
# compose.prod.yml, que a su vez deben apuntar (fuera de Docker, con
# un bind mount si hace falta) al disco externo real y, si se
# confirma la licencia (S-10), a OneDrive. Si una no está configurada,
# ese destino queda PENDIENTE y no falla el respaldo completo.
SIGEDA_BACKUP_DISCO_EXTERNO_DIR=/app/respaldos/disco_externo
# SIGEDA_BACKUP_ONEDRIVE_DIR=/app/respaldos/onedrive

# Carpeta de exportación (PAN-12). En esta laptop de producción, igual
# que arriba, es una ruta dentro del volumen Docker; en el sistema
# real la usuaria elige la carpeta de Windows desde el instalador
# (infra/windows/), que monta esa ruta elegida aquí.
SIGEDA_EXPORT_DIR=/app/exportaciones


# -----------------------------------------------------------------------------
# Exposición local
# -----------------------------------------------------------------------------

HTTP_PORT=80