POSTGRES_DB=sigeda

POSTGRES_USER=sigeda

POSTGRES_PASSWORD=change_me

POSTGRES_PORT=5432

# Clave AES-256 (32 bytes) en base64 para el almacén de documentos
# cifrados (RNF-10). Generarla con:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# NUNCA reutilizar la de ejemplo ni subir la real a Git.
DOCUMENT_ENCRYPTION_KEY_B64=change_me

DOCUMENT_STORAGE_ROOT=/app/almacen_cifrado

# RF-16/ADR-03: destinos del paquete de respaldo cifrado. SUPUESTO de
# entorno (CLAUDE.md sección 6): en este entorno de desarrollo son
# rutas de carpeta dentro del volumen "sigeda_respaldos", no una
# unidad USB real ni una licencia de OneDrive confirmada (S-10). Si
# una no está configurada, ese destino queda PENDIENTE y no falla el
# respaldo completo.
SIGEDA_BACKUP_DISCO_EXTERNO_DIR=/app/respaldos/disco_externo
# SIGEDA_BACKUP_ONEDRIVE_DIR=/app/respaldos/onedrive

# RF-18/RN-10: carpeta de exportación (PAN-12). SUPUESTO de entorno
# (igual que arriba): en este entorno de desarrollo es una ruta dentro
# del volumen "sigeda_exportaciones", no la carpeta real que elija la
# usuaria en la laptop.
SIGEDA_EXPORT_DIR=/app/exportaciones
